{
  "version": "2.0.0",
  "tasks": [
    {
      // The one task the NPM Scripts view cannot replace.
      //
      // Every script in this repo is already one click away in Explorer → NPM
      // Scripts, so a task per script would be a second, staler copy of that
      // list. This one earns its place by being the `preLaunchTask` of the
      // "Website" debug config: a launch config can only wait on a *task*, and
      // waiting correctly on a dev server needs the background matcher below.
      "label": "dev:web",
      "type": "npm",
      "script": "dev:web",
      "isBackground": true,

      // Reveal it, don't hide it. `strictPort` is not set in
      // apps/web/vite.config.ts, so a busy 3000 moves the site to 3001 with
      // only a line of terminal output to say so — and the debug config is
      // pointed at 3000. The terminal is where that is visible.
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },

      "problemMatcher": {
        "owner": "vite",

        // Deliberately inert. `vite` serves without type-checking — `npm run
        // lint` in apps/web is what runs tsc — so there is nothing here to
        // parse into the Problems panel. A pattern is required all the same,
        // because `background` lives inside a matcher, and that is the whole
        // reason this block exists.
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+)\\):\\s*(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },

        // How VS Code knows a server that never exits is nonetheless ready.
        // Without this it waits for the process to end, the debug session
        // never starts, and the only symptom is nothing happening.
        //
        // Matched against Vite 6's real output: `VITE v6.4.3  ready in 884 ms`
        // on boot, and `restarting server...` / `server restarted.` when
        // vite.config.ts is edited. Kept to single unbroken words because the
        // line arrives wrapped in ANSI colour codes, which sit between `VITE`
        // and its version number.
        "background": {
          "activeOnStart": true,
          "beginsPattern": "restarting|VITE",
          "endsPattern": "ready in|server restarted"
        }
      }
    }
  ]
}
