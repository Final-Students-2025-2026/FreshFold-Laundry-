# Committed template. Copy to `.env` and fill in real values there — this file
# is in git, so it must never carry a key.

# The domain this build will actually be served from, no trailing slash.
#
# It goes into the canonical tag, the share card's og:url, the sitemap and the
# LocalBusiness structured data — four claims about where the real site lives,
# all of which are actively harmful when wrong. A preview deploy that claims to
# be canonical is a preview deploy in the search results.
#
# Set it to the same value as the server's APP_URL. Left unset, the build warns
# and falls back to https://freshfold.com.
SITE_URL=https://freshfold.com

# Where funnel events are posted, as a same-origin path. Empty means analytics
# is off, which is the default — the dispatch server has no endpoint for these
# yet, and a module that posts into the void on every click is worse than one
# that does nothing. The instrumentation is already at the call sites, so
# turning it on is this one variable plus a route that accepts
# `{ events: [...], sentAt }`.
#
# Same-origin by necessity as well as by choice: the site's CSP is
# `connect-src 'self'`, so a third-party analytics endpoint would be blocked —
# and this page collects addresses and phone numbers, which have no business
# reaching an ad network. See src/services/analytics.ts.
VITE_ANALYTICS_PATH=

# Where the dispatch server lives. Only needed if it is not on localhost:4000 —
# the dev server proxies /api there by default.
API_URL=http://localhost:4000

# Google Maps key for the live dispatch map. Without it the map falls back to a
# static suburb diagram, which is fine for local development.
#
# Either spelling works and one is enough: `VITE_` reaches the app through
# `import.meta.env`, the unprefixed one through `define` in vite.config.ts.
# This key ships in the browser bundle by design — restrict it to the Maps
# JavaScript API by HTTP referrer, and keep the server's Routes-enabled key
# well away from it.
VITE_GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# Cloud Map ID for the dispatch map. Every pin on it is an `AdvancedMarker`,
# which requires one. Left empty the map uses Google's `DEMO_MAP_ID`, which
# renders but warns on every load and is not supported in production — create a
# Map ID in the cloud console and put it here before shipping. A Map ID with a
# cloud style attached also overrides the map's own light/dark toggle.
VITE_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_MAP_ID=

# Set to `true` to turn off HMR and file watching (AI Studio needs this).
DISABLE_HMR=false
