{
  "name": "@freshfold/client",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "FreshFold — the customer app. Everything the website offers, plus the live-dispatch surfaces the rider app introduced.",
  "scripts": {
    "start": "cross-env EXPO_NO_CACHE=1 expo start",
    "android": "cross-env EXPO_NO_CACHE=1 expo start --android",
    "ios": "cross-env EXPO_NO_CACHE=1 expo start --ios",
    "web": "cross-env EXPO_NO_CACHE=1 expo start --web",
    "lint": "tsc --noEmit",
    "check": "node scripts/secrets.check.mjs && tsx src/services/checkout.check.ts",
    "i18n": "tsx src/i18n/coverage.report.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@freshfold/core": "*",
    "@freshfold/rn-maps": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.21.0",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0"
  }
}
