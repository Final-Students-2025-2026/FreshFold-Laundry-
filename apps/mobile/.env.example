# Where the FreshFold dispatch server is running.
#
# Leave this blank and the app derives it from the Expo dev server's host — if
# you are running `npm run dev` on the same machine, that is usually correct and
# no configuration is needed. Set it explicitly when the server lives elsewhere.
#
# `localhost` will NOT work from a physical phone; use the LAN address of the
# machine running the server, e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_URL=

# Optional. Only needed for standalone Android builds (`npx expo prebuild` / EAS).
# Expo Go and iOS (Apple Maps) render the live map without any key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=""

# Optional. Set this and iOS renders Google Maps instead of Apple Maps, so the
# courier's console, the customer app and the supervisor's web dashboard all
# draw the same roads. Without it, iOS falls back to Apple Maps — a map either
# way, which is why it is not required.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=""
